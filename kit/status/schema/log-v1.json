{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Log page, contract 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "next"],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "at", "level", "code", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "at": { "type": "string", "format": "date-time" },
          "level": { "enum": ["info", "warn", "error"] },
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$", "maxLength": 100 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "link": { "type": "string", "format": "uri-reference", "maxLength": 2048 }
        }
      }
    },
    "next": { "type": "string", "maxLength": 200 }
  }
}
