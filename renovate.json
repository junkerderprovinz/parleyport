{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Go modules: auto-merge minor/patch once CI is green",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "!github.com/rclone/rclone",
        "!github.com/anacrolix/torrent",
        "!github.com/restic/restic"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The compose file is for people to copy, so it follows the app's own latest tag instead of a digest that goes stale every build",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "junkerderprovinz/parleyport"
      ],
      "enabled": false
    }
  ]
}
